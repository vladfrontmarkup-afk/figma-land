  "private": true,
  "type": "module",
  "description": "Website for Client Company",
  "author": {
    "name": "Vladyslav Kolotko",
    "url": "https://your-portfolio.com"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "watch": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "studio:dev": "npm --prefix studio run dev --",
